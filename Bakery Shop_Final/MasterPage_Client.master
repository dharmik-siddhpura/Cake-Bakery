<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage_Client.master.cs" Inherits="MasterPage_Client" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    
