            <!--================Main Header Area =================-->
		    <header class="main_header_area">

            <%-- Header Part Start************************************************** --%>
			    <div class="top_header_area row m0">
                    <div class="container">
                        <div class="float-left">
                            <a href="tell:+91 1234567089"><i class="fa fa-phone" aria-hidden="true"></i>(+91) 1234567089</a> <a href="mailto:info@BackeryShop.com"><i class="fa fa-envelope-o" aria-hidden="true"></i>info@BackeryShop.com</a>
                        </div>
                        <div class="float-right">
                            <ul class="h_search list_style">
                                <li><a href="Frm_Cart.aspx"><i class="lnr lnr-cart"></i></a>&nbsp&nbsp&nbsp<asp:Label ID="Lable_showName" runat="server" Text="Label" Font-Bold="True" ForeColor="White" Visible="false"></asp:Label>
                                </li><%--Class-shop_cart--%>
