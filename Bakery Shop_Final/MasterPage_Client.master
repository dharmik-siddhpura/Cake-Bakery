                        </div>
                    </div>
                </div>
			 <%-- Header Part over************************************************** --%>
                <div class="main_menu_two">
                    <div class="container">
                        <nav class="navbar navbar-expand-lg navbar-light bg-light">
                            <a class="navbar-brand" href="HomePage.aspx">
                            <img src="Style_Js/img/logo-2.png" alt=""></a>
                            <asp:Menu ID="Menu1" runat="server" Orientation="Horizontal" CssClass="navbar-nav justify-content-end" >
                                <Items>
                                    <asp:MenuItem Text="Home" Value="Home" NavigateUrl="~/HomePage.aspx"></asp:MenuItem>
                                    <asp:MenuItem Text="Product" Value="Product" NavigateUrl="~/Frm_Product.aspx"></asp:MenuItem>
                                    <asp:MenuItem Text="Cart" Value="Contect Us" NavigateUrl="~/Frm_Cart.aspx"></asp:MenuItem>
                                    <asp:MenuItem Text="My Order" Value="My Order" NavigateUrl="~/Frm_MyOrder.aspx"></asp:MenuItem>
                                    <asp:MenuItem Text="Login" Value="Register" NavigateUrl="~/Frm_Login.aspx"></asp:MenuItem>
                                </Items>
                            </asp:Menu>
                            <%--<asp:Menu ID="Menu2" runat="server" Orientation="Horizontal" CssClass="navbar-nav justify-content-end" Visible="False" >
                                <Items>
                                    <asp:MenuItem Text="Home" Value="Home" NavigateUrl="~/Homepage.aspx"></asp:MenuItem>
                                    <asp:MenuItem Text="Product" Value="Product" NavigateUrl="~/Frm_Product.aspx"></asp:MenuItem>
                                    <asp:MenuItem Text="Cart" Value="Contect Us" NavigateUrl="~/Frm_Cart.aspx"></asp:MenuItem>
                                    <asp:MenuItem Text="Logout" Value="Register" NavigateUrl="~/Frm_Login.aspx"></asp:MenuItem>
                                </Items>
                            </asp:Menu>--%>
                        </nav>
